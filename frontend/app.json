{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.dangermeter.gt98hx"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.dangermeter.gt98hx"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8808437175840036~1440577317",
          "iosAppId": "ca-app-pub-8808437175840036~5805345652"
        }
      ],
      "expo-build-properties"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "515619e8-2536-4a59-a3f1-17a1a52bc271"
      }
    },

    "owner": "mahekaru"
  },

  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-8808437175840036~1440577317",
    "ios_app_id": "ca-app-pub-8808437175840036~5805345652"
  }
}